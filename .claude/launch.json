{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "allianceo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "bureau-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "bureau",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "site-vitrine",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "site"
      ],
      "port": 8090
    }
  ]
}