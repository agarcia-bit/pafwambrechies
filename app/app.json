{
  "expo": {
    "name": "Allianceo",
    "slug": "allianceo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allianceo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.agalumy.allianceo",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.agalumy.allianceo",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allianceo ajoute les événements de votre association à votre agenda."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allianceo utilise vos photos pour illustrer les fiches de l’annuaire.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89e143c3-1fb5-4435-9c4e-5b6fba75012f"
      }
    },
    "owner": "agalumy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89e143c3-1fb5-4435-9c4e-5b6fba75012f"
    }
  }
}
